---
interface Props {
  title: string;
  id: string;
}

const { title, id } = Astro.props;
---

<div class="sticky top-0 z-20 -mx-6 mb-4 w-screen bg-slate-950/75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0">
  <h2 class="text-sm font-bold uppercase tracking-widest text-slate-200">
    {title}
  </h2>
</div>
