---
interface Props {
  currentLang: 'zh' | 'en';
}

const { currentLang } = Astro.props;
---

<div class="inline-flex items-center gap-1 rounded-full border border-slate-800 bg-slate-900/80 p-1 text-xs font-mono backdrop-blur">
  <span class="pl-2 pr-1 text-slate-500 flex items-center">
    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
  </span>

  {currentLang === 'zh' ? (
    <button
      type="button"
      onclick="localStorage.setItem('preferred-lang', 'zh')"
      class="rounded-full bg-sky-950 px-2.5 py-0.5 font-semibold text-sky-300 border border-sky-800/50 shadow-sm cursor-default"
    >
      中文
    </button>
  ) : (
    <a
      href="/"
      onclick="localStorage.setItem('preferred-lang', 'zh')"
      class="rounded-full px-2.5 py-0.5 text-slate-400 hover:text-slate-200 hover:bg-slate-800/60 transition-colors"
      aria-label="切换到中文页面"
    >
      中文
    </a>
  )}

  <span class="text-slate-600">/</span>

  {currentLang === 'en' ? (
    <button
      type="button"
      onclick="localStorage.setItem('preferred-lang', 'en')"
      class="rounded-full bg-sky-950 px-2.5 py-0.5 font-semibold text-sky-300 border border-sky-800/50 shadow-sm cursor-default"
    >
      EN
    </button>
  ) : (
    <a
      href="/en/"
      onclick="localStorage.setItem('preferred-lang', 'en')"
      class="rounded-full px-2.5 py-0.5 text-slate-400 hover:text-slate-200 hover:bg-slate-800/60 transition-colors"
      aria-label="Switch to English version"
    >
      EN
    </a>
  )}
</div>
