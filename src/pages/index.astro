---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import { portfolioZh as portfolioData } from '../data/portfolio.zh';

const { personal, navItems, experiences, projects, skillCategories, education, ui } = portfolioData;
---

<Layout 
  title={`${personal.name} | ${personal.title}`} 
  description={`${personal.name} 的个人主页与技术作品集。${personal.tagline}`}
  lang="zh-CN"
>
  <div class="mx-auto min-h-screen max-w-screen-xl px-6 py-12 md:px-12 md:py-20 lg:px-24 lg:py-0">
    <div class="lg:flex lg:justify-between lg:gap-4">
      
      <!-- ================= LEFT COLUMN: HERO & STICKY NAV ================= -->
      <header class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-1/2 lg:flex-col lg:justify-between lg:py-24">
        <div>
          <!-- Language Toggle -->
          <div class="mb-6">
            <LanguageToggle currentLang="zh" />
          </div>

          <h1 class="text-4xl font-bold tracking-tight text-slate-100 sm:text-5xl">
            <a href="/">{personal.name}</a>
          </h1>
          <h2 class="mt-3 text-lg font-medium tracking-tight text-sky-400 sm:text-xl">
            {personal.title}
          </h2>
          <p class="mt-4 max-w-xs text-sm leading-relaxed text-slate-400">
            {personal.tagline}
          </p>

          <!-- Desktop Sticky Navigation -->
          <nav class="nav hidden lg:block" aria-label="页面快捷导航">
            <ul class="mt-16 w-max space-y-4">
              {navItems.map((item, idx) => (
                <li>
                  <a 
                    class="group flex items-center py-1 transition-all" 
                    href={item.href}
                    target={item.external ? "_blank" : undefined}
                    rel={item.external ? "noreferrer noopener" : undefined}
                  >
                    <span class={`nav-indicator mr-4 h-px transition-all motion-reduce:transition-none ${idx === 0 ? 'w-16 bg-sky-400' : 'w-8 bg-slate-600'} group-hover:w-16 group-hover:bg-slate-200 group-focus-visible:w-16 group-focus-visible:bg-slate-200`}></span>
                    <span class={`nav-text text-xs font-bold uppercase tracking-widest ${idx === 0 ? 'text-slate-200' : 'text-slate-500'} group-hover:text-slate-200 group-focus-visible:text-slate-200 flex items-center gap-1`}>
                      {item.label}
                      {(!item.href.startsWith('#')) && (
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="inline-block h-3 w-3 shrink-0 opacity-70 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true">
                          <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
                        </svg>
                      )}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>

        <!-- Social Media / Contact Links -->
        <div class="mt-8 flex flex-col gap-4">
          <ul class="flex items-center gap-5 text-slate-400" aria-label="社交与联系方式">
            <!-- GitHub -->
            <li>
              <a 
                href={personal.github} 
                target="_blank" 
                rel="noreferrer noopener"
                class="block hover:text-sky-300 transition-colors"
                aria-label="GitHub 主页"
              >
                <span class="sr-only">GitHub</span>
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
              </a>
            </li>

            <!-- Email -->
            <li>
              <a 
                href={`mailto:${personal.email}`} 
                class="block hover:text-sky-300 transition-colors"
                aria-label="发送邮件"
              >
                <span class="sr-only">Email</span>
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </a>
            </li>

            <!-- Resume Link / Icon -->
            {personal.resumeUrl && (
              <li>
                <a 
                  href={personal.resumeUrl} 
                  target="_blank" 
                  rel="noreferrer noopener"
                  class="block hover:text-sky-300 transition-colors"
                  aria-label="查看个人简历"
                  title="查看简历"
                >
                  <span class="sr-only">Resume</span>
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                </a>
              </li>
            )}
          </ul>

          {personal.location && (
            <p class="text-xs text-slate-500 font-mono flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {personal.location}
            </p>
          )}
        </div>
      </header>


      <!-- ================= RIGHT COLUMN: SCROLLABLE SECTIONS ================= -->
      <main class="pt-24 lg:w-1/2 lg:py-24">

        <!-- 1. ABOUT SECTION -->
        <section id="about" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-32 lg:scroll-mt-24" aria-label="关于我">
          <SectionHeader title="关于我" id="about" />
          <div class="space-y-4 text-slate-300 leading-relaxed text-sm sm:text-base">
            {personal.bio.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>

        <!-- 2. EXPERIENCE SECTION -->
        <section id="experience" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-32 lg:scroll-mt-24" aria-label="工作经历">
          <SectionHeader title="工作经历" id="experience" />
          <div class="group/list space-y-12">
            {experiences.map((exp) => (
              <ExperienceCard experience={exp} />
            ))}
          </div>

          <!-- Resume Link -->
          {personal.resumeUrl && (
            <div class="mt-12">
              <a
                class="inline-flex items-center font-medium leading-tight text-slate-200 font-mono text-sm hover:text-sky-300 group/link"
                href={personal.resumeUrl}
                target="_blank"
                rel="noreferrer noopener"
                aria-label="查看完整简历 PDF"
              >
                <span>查看完整简历 PDF</span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="inline-block h-4 w-4 shrink-0 transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none ml-1.5 translate-y-px" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          )}
        </section>

        <!-- 3. PROJECTS SECTION -->
        <section id="projects" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-32 lg:scroll-mt-24" aria-label="精选项目">
          <SectionHeader title="精选项目" id="projects" />
          <div class="group/list space-y-12">
            {projects.map((proj) => (
              <ProjectCard project={proj} />
            ))}
          </div>

          <!-- More Projects on GitHub -->
          <div class="mt-12">
            <a
              class="inline-flex items-center font-medium leading-tight text-slate-200 font-mono text-sm hover:text-sky-300 group/link"
              href={`${personal.github}?tab=repositories`}
              target="_blank"
              rel="noreferrer noopener"
              aria-label="查看 GitHub 上的全部项目仓库"
            >
              <span>在 GitHub 上浏览全部仓库</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="inline-block h-4 w-4 shrink-0 transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none ml-1.5 translate-y-px" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </section>

        <!-- 4. SKILLS SECTION -->
        <section id="skills" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-32 lg:scroll-mt-24" aria-label="专业技能">
          <SectionHeader title="专业技能" id="skills" />
          <div class="space-y-6">
            {skillCategories.map((cat) => (
              <div class="rounded-lg border border-slate-800/80 bg-slate-900/40 p-4 transition hover:border-slate-700/80">
                <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-sky-400 mb-3">
                  {cat.category}
                </h3>
                <div class="flex flex-wrap gap-2">
                  {cat.skills.map((skill) => (
                    <span class="rounded bg-slate-800/80 px-2.5 py-1 text-xs text-slate-300 border border-slate-700/50">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- 5. EDUCATION SECTION -->
        <section id="education" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-32 lg:scroll-mt-24" aria-label="教育背景">
          <SectionHeader title="教育背景" id="education" />
          <div class="space-y-8">
            {education.map((edu) => (
              <div class="rounded-lg border border-slate-800/80 bg-slate-900/40 p-5 transition hover:border-slate-700/80">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-2">
                  <h3 class="text-base font-semibold text-slate-100">
                    {edu.school}
                  </h3>
                  <span class="text-xs font-mono text-slate-500 uppercase tracking-wide">
                    {edu.period}
                  </span>
                </div>
                <p class="text-sm text-sky-400 font-medium mb-2">
                  {edu.degree} · {edu.major}
                </p>
                {edu.details && (
                  <ul class="text-xs text-slate-400 space-y-1 list-disc list-outside pl-4 marker:text-sky-400/80">
                    {edu.details.map((detail) => (
                      <li>{detail}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>

        <!-- FOOTER -->
        <footer class="max-w-md pb-16 text-xs text-slate-500 sm:pb-0 font-mono">
          <p>
            Designed & Built with <a href="https://astro.build" target="_blank" rel="noreferrer" class="text-slate-400 hover:text-sky-300">Astro</a> and <a href="https://tailwindcss.com" target="_blank" rel="noreferrer" class="text-slate-400 hover:text-sky-300">Tailwind CSS</a>.
            Hosted on <a href="https://pages.github.com" target="_blank" rel="noreferrer" class="text-slate-400 hover:text-sky-300">GitHub Pages</a>.
          </p>
        </footer>

      </main>

    </div>
  </div>
</Layout>
